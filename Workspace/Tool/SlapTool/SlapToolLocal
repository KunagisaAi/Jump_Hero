-- LocalScript in SlapTool
local Tool = script.Parent
local Player = game.Players.LocalPlayer
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- 假设有一个RemoteEvent用于客户端-服务器通信
local SlapEvent = ReplicatedStorage:WaitForChild("SlapEvent")

-- 播放反馈（动画、音效）
local function PlayFeedback()
	-- 假设有一个音效
	local Sound = Instance.new("Sound")
	Sound.SoundId = "rbxassetid://123456789" -- 替换为实际音效ID
	Sound.Parent = Tool
	Sound:Play()
	-- 播放手臂挥动动画（需要Animation对象）
	local Animation = Instance.new("Animation")
	Animation.AnimationId = "rbxassetid://987654321" -- 替换为实际动画ID
	local Track = Player.Character.Humanoid:LoadAnimation(Animation)
	Track:Play()
end

-- UI设置
local function CreateUI()
	local ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Parent = Player.PlayerGui
	ScreenGui.Name = "SlapUI"

	local Frame = Instance.new("Frame")
	Frame.Size = UDim2.new(0, 200, 0, 100)
	Frame.Position = UDim2.new(0.5, -100, 0.8, -50)
	Frame.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	Frame.Parent = ScreenGui

	local SlapButton = Instance.new("TextButton")
	SlapButton.Size = UDim2.new(0, 100, 0, 40)
	SlapButton.Position = UDim2.new(0.5, -50, 0.5, -20)
	SlapButton.Text = "Slap!"
	SlapButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
	SlapButton.Parent = Frame

	local CountLabel = Instance.new("TextLabel")
	CountLabel.Size = UDim2.new(0, 200, 0, 20)
	CountLabel.Position = UDim2.new(0.5, -100, 0.1, 0)
	CountLabel.Text = "Slaps: " .. Tool.SlapCount.Value
	CountLabel.BackgroundTransparency = 1
	CountLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	CountLabel.Parent = Frame

	-- 更新UI
	Tool.SlapCount.Changed:Connect(function(newCount)
		CountLabel.Text = "Slaps: " .. newCount
		if newCount <= 0 then
			SlapButton.Text = "No Slaps!"
			SlapButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
			SlapButton.Active = false
		else
			SlapButton.Text = "Slap!"
			SlapButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
			SlapButton.Active = true
		end
	end)

	-- 按钮点击
	SlapButton.MouseButton1Click:Connect(function()
		if Tool.SlapCount.Value > 0 then
			SlapEvent:FireServer()
			-- 播放本地反馈（动画、音效）
			PlayFeedback()
		end
	end)
end

-- 按键输入（Q键）
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and input.KeyCode == Enum.KeyCode.Q and Tool.SlapCount.Value > 0 then
		SlapEvent:FireServer()
		PlayFeedback()
	end
end)

-- 初始化UI
Tool.Equipped:Connect(CreateUI)
Tool.Unequipped:Connect(function()
	if Player.PlayerGui:FindFirstChild("SlapUI") then
		Player.PlayerGui.SlapUI:Destroy()
	end
end)