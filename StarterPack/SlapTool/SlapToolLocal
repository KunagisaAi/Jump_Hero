-- LocalScript in SlapTool
local Tool = script.Parent
local Player = game.Players.LocalPlayer
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- RemoteEvent
local SlapEvent = ReplicatedStorage:WaitForChild("SlapEvent")

-- 播放反馈（动画、音效）
local function PlayFeedback()
	-- 音效（替换为实际音效 ID）
	local Sound = Instance.new("Sound")
	Sound.SoundId = "rbxassetid://123456789" -- 替换为你的音效 ID
	Sound.Parent = Tool
	Sound:Play()
	game.Debris:AddItem(Sound, 2) -- 2 秒后销毁音效

	-- 动画（替换为实际动画 ID）
	if Player.Character and Player.Character:FindFirstChild("Humanoid") then
		local Animation = Instance.new("Animation")
		Animation.AnimationId = "rbxassetid://987654321" -- 替换为你的动画 ID
		local Track = Player.Character.Humanoid:LoadAnimation(Animation)
		Track:Play()
	end
end

-- 按键输入（Q 键）
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and input.KeyCode == Enum.KeyCode.Q and Tool.SlapCount.Value > 0 then
		SlapEvent:FireServer()
		PlayFeedback()
	end
end)

-- 装备时更新装备栏显示
local function UpdateToolTip()
	Tool.ToolTip = "Slaps: " .. Tool.SlapCount.Value
	if Tool.SlapCount.Value <= 0 then
		Tool.ToolTip = "No Slaps Left!"
	end
end

-- 初始化和监听 SlapCount 变化
Tool.Equipped:Connect(function()
	UpdateToolTip()
	Tool.SlapCount.Changed:Connect(UpdateToolTip)
end)

-- 卸下时清理（可选）
Tool.Unequipped:Connect(function()
	-- 可以选择清理，但 ToolTip 会自动随 SlapCount 更新
end)