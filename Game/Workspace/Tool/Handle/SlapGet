-- 实际上这个脚本不能放那边，不然会报错
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")

local TOOL_NAME = "SlapTool"
local ORIGINAL_TOOL = ServerStorage:WaitForChild(TOOL_NAME)

local function FindExistingSlapTool(player)
	local backpack = player:FindFirstChild("Backpack")
	local character = player.Character
	if not backpack then return nil end

	-- 先检查装备中（当前手上拿着的 Tool）
	if character then
		for _, tool in ipairs(character:GetChildren()) do
			if tool:IsA("Tool") and tool:FindFirstChild("SlapCount") then
				return tool
			end
		end
	end

	-- 再检查背包
	for _, tool in ipairs(backpack:GetChildren()) do
		if tool:IsA("Tool") and tool:FindFirstChild("SlapCount") then
			return tool
		end
	end

	return nil
end

-- 主函数：给玩家巴掌道具（支持叠加）
local function GiveSlapTool(player)
	local existingTool = FindExistingSlapTool(player)

	if existingTool then
		-- 已存在：叠加次数 +1
		local slapCount = existingTool:FindFirstChild("SlapCount")
		if slapCount then
			slapCount.Value = slapCount.Value + 1
			print(player.Name .. " 巴掌次数 +1，现在 x" .. slapCount.Value)
		end
	else
		-- 不存在：克隆新道具给玩家
		local newTool = ORIGINAL_TOOL:Clone()
		newTool.Parent = player.Backpack
		print(player.Name .. " 首次获得巴掌道具")
	end
end

