local Tool = script.Parent
local Player = game.Players.LocalPlayer
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ShieldEvent = ReplicatedStorage:WaitForChild("ShieldEvent")
local RemoveToolEvent = ReplicatedStorage:WaitForChild("RemoveToolEvent")
local PlayerGui = Player:WaitForChild("PlayerGui")

local ShieldUI = nil
local animationTrack = nil

-- 创建护盾专属 UI（不变）
local function CreateShieldUI()
	if ShieldUI then return end

	ShieldUI = Instance.new("ScreenGui")
	ShieldUI.Name = "ShieldToolUI"
	ShieldUI.ResetOnSpawn = false
	ShieldUI.Parent = PlayerGui

	local MainFrame = Instance.new("Frame")
	MainFrame.Name = "MainFrame"
	MainFrame.Size = UDim2.new(0, 120, 0, 120)
	MainFrame.Position = UDim2.new(0, 30, 1, -150)  -- 左下角，可调
	MainFrame.BackgroundTransparency = 0.4
	MainFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	MainFrame.BorderSizePixel = 0
	MainFrame.Parent = ShieldUI

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 60)
	Corner.Parent = MainFrame

	local BorderFrame = Instance.new("Frame")
	BorderFrame.Size = UDim2.new(1, 10, 1, 10)
	BorderFrame.Position = UDim2.new(0, -5, 0, -5)
	BorderFrame.BackgroundTransparency = 0.6
	BorderFrame.BackgroundColor3 = Color3.fromRGB(100, 200, 255)  -- 蓝光边框
	BorderFrame.BorderSizePixel = 0
	BorderFrame.ZIndex = MainFrame.ZIndex - 1
	BorderFrame.Parent = MainFrame

	local BorderCorner = Instance.new("UICorner")
	BorderCorner.CornerRadius = UDim.new(0, 65)
	BorderCorner.Parent = BorderFrame

	-- 盾牌图片
	local ShieldImage = Instance.new("ImageLabel")
	ShieldImage.Name = "ShieldImage"
	ShieldImage.Size = UDim2.new(0, 80, 0, 80)
	ShieldImage.Position = UDim2.new(0.5, -40, 0.5, -40)
	ShieldImage.BackgroundTransparency = 1
	ShieldImage.Image = "rbxassetid://122269719475476"
	ShieldImage.Parent = MainFrame

	local ImageCorner = Instance.new("UICorner")
	ImageCorner.CornerRadius = UDim.new(0, 40)
	ImageCorner.Parent = ShieldImage

	-- 等级（左下）
	local LevelLabel = Instance.new("TextLabel")
	LevelLabel.Name = "LevelLabel"
	LevelLabel.Size = UDim2.new(0, 50, 0, 25)
	LevelLabel.Position = UDim2.new(0, 10, 1, -35)
	LevelLabel.BackgroundTransparency = 0.6
	LevelLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	LevelLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
	LevelLabel.TextScaled = true
	LevelLabel.Font = Enum.Font.GothamBold
	LevelLabel.Text = "Lv.1"
	LevelLabel.Parent = MainFrame

	local LevelCorner = Instance.new("UICorner")
	LevelCorner.CornerRadius = UDim.new(0, 8)
	LevelCorner.Parent = LevelLabel

	-- 数量（右下）
	local CountLabel = Instance.new("TextLabel")
	CountLabel.Name = "CountLabel"
	CountLabel.Size = UDim2.new(0, 50, 0, 25)
	CountLabel.Position = UDim2.new(1, -60, 1, -35)
	CountLabel.BackgroundTransparency = 0.6
	CountLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	CountLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
	CountLabel.TextScaled = true
	CountLabel.Font = Enum.Font.GothamBold
	CountLabel.Text = "x10"
	CountLabel.Parent = MainFrame

	local CountCorner = Instance.new("UICorner")
	CountCorner.CornerRadius = UDim.new(0, 8)
	CountCorner.Parent = CountLabel
end

-- 更新 UI（不变）
local function UpdateShieldUI()
	if not ShieldUI then return end
	local ShieldCount = Tool:FindFirstChild("ShieldCount")
	local ShieldLevel = Tool:FindFirstChild("ShieldLevel")
	if not ShieldCount or not ShieldLevel then return end

	local LevelLabel = ShieldUI.MainFrame.LevelLabel
	local CountLabel = ShieldUI.MainFrame.CountLabel

	LevelLabel.Text = "Lv." .. ShieldLevel.Value
	CountLabel.Text = "x" .. ShieldCount.Value

	CountLabel.TextColor3 = ShieldCount.Value > 0 and Color3.fromRGB(255, 255, 100) or Color3.fromRGB(255, 100, 100)
end

-- 播放使用反馈（不变）
local function PlayFeedback()
	local Sound = Instance.new("Sound")
	Sound.SoundId = "rbxassetid://138081500"  -- 护盾激活音效
	Sound.Volume = 0.8
	Sound.Parent = Tool
	Sound:Play()
	game.Debris:AddItem(Sound, 3)

	-- 激活动画
	if Player.Character and Player.Character:FindFirstChild("Humanoid") and animationTrack then
		animationTrack:Stop()
		animationTrack:Play()
	end
end

-- Q键触发（不变）
local canShield = true
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and input.KeyCode == Enum.KeyCode.Q and canShield then
		if Tool.Parent == Player.Character then
			local ShieldCount = Tool:FindFirstChild("ShieldCount")
			if ShieldCount and ShieldCount.Value > 0 then
				canShield = false
				ShieldEvent:FireServer()
				PlayFeedback()
				task.wait(1)
				canShield = true
			end
		end
	end
end)

local function CleanupTool()
	if ShieldUI then
		ShieldUI:Destroy()
		ShieldUI = nil
	end
	if animationTrack then
		animationTrack:Stop()
		animationTrack = nil
	end

	if RemoveToolEvent then
		RemoveToolEvent:FireServer("ShieldTool")
	end
end

-- **Rebuild 函数（装备时重建 UI + 动画 + 绑定 Died）**
local function RebuildUIAndAnimation()
	CreateShieldUI()
	UpdateShieldUI()

	if Player.Character and Player.Character:FindFirstChild("Humanoid") then
		local Animation = Instance.new("Animation")
		Animation.AnimationId = "rbxassetid://507766388"
		animationTrack = Player.Character.Humanoid:LoadAnimation(Animation)
		animationTrack.Looped = false
	end

	Tool.ShieldCount.Changed:Connect(UpdateShieldUI)
	Tool.ShieldLevel.Changed:Connect(UpdateShieldUI)

	-- **关键：绑定当前 Humanoid 的 Died 事件**
	local humanoid = Player.Character:FindFirstChild("Humanoid")
	if humanoid then
		humanoid.Died:Connect(CleanupTool)
	end
end

-- 装备时触发 Rebuild
Tool.Equipped:Connect(RebuildUIAndAnimation)

-- 数量 <=0 时清理
Tool.ShieldCount.Changed:Connect(function(newCount)
	UpdateShieldUI()
	if newCount <= 0 then
		CleanupTool()
	end
end)

-- 卸下时清理
Tool.Unequipped:Connect(function()
	if ShieldUI then
		ShieldUI:Destroy()
		ShieldUI = nil
	end
	if animationTrack then
		animationTrack:Stop()
		animationTrack = nil
	end
end)

-- 复活时重建 + 重新绑定 Died
Player.CharacterAdded:Connect(function(character)
	task.wait(1)
	local equippedTool = character:FindFirstChildWhichIsA("Tool")
	if equippedTool and equippedTool:FindFirstChild("ShieldCount") then
		RebuildUIAndAnimation()
	end
end)

-- 初始检查
task.spawn(function()
	task.wait(2)
	if Tool.Parent == Player.Character then
		RebuildUIAndAnimation()
	end
end)