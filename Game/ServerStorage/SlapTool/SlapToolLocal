-- 更新 UI 显示内容（不变）
local function UpdateSlapUI()
	if not SlapUI then return end

	local SlapCount = Tool:FindFirstChild("SlapCount")
	local SlapLevel = Tool:FindFirstChild("SlapLevel")
	if not SlapCount or not SlapLevel then return end

	local LevelLabel = SlapUI.MainFrame.LevelLabel
	local CountLabel = SlapUI.MainFrame.CountLabel

	LevelLabel.Text = "Lv." .. SlapLevel.Value
	CountLabel.Text = "x" .. SlapCount.Value

	if SlapCount.Value <= 0 then
		CountLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
	else
		CountLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
	end
end

-- 优化后的播放反馈（关键改动！）
local function PlayFeedback()
	-- 音效
	local Sound = Instance.new("Sound")
	Sound.SoundId = "rbxassetid://1835341225"  -- 巴掌音效
	Sound.Volume = 0.8
	Sound.Parent = Tool
	Sound:Play()
	game.Debris:AddItem(Sound, 3)

	-- 动画：只播放一次（缓存Track + Stop再Play）
	if Player.Character and Player.Character:FindFirstChild("Humanoid") and animationTrack then
		animationTrack:Stop()  -- 先停止，确保不叠加
		animationTrack:Play()  -- 从头播放一次
	end
end

-- 按 Q 键触发（新增冷却，防止锤Q）
local canSlap = true  -- 新增冷却变量
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and input.KeyCode == Enum.KeyCode.Q and canSlap then
		-- 新增：只有装备时才能使用
		if Tool.Parent == Player.Character then  -- 道具在角色里 = 已装备
			local SlapCount = Tool:FindFirstChild("SlapCount")
			if SlapCount and SlapCount.Value > 0 then
				canSlap = false
				SlapEvent:FireServer()
				PlayFeedback()
				task.wait(1)  -- 冷却时间
				canSlap = true
			end
		end
	end
end)

-- 装备时：创建UI + 加载动画Track（只一次）
Tool.Equipped:Connect(function()
	CreateSlapUI()
	UpdateSlapUI()

	-- 加载动画Track（只加载一次）
	if Player.Character and Player.Character:FindFirstChild("Humanoid") then
		local Animation = Instance.new("Animation")
		Animation.AnimationId = "rbxassetid://507770239"  -- 扇巴掌动画
		animationTrack = Player.Character.Humanoid:LoadAnimation(Animation)
		animationTrack.Looped = false  -- 不循环，只播一次
	end

	-- 监听数值变化
	Tool.SlapCount.Changed:Connect(UpdateSlapUI)
	Tool.SlapLevel.Changed:Connect(UpdateSlapUI)
end)

-- 卸下时：隐藏UI + 清理动画Track
Tool.Unequipped:Connect(function()
	if SlapUI then
		SlapUI:Destroy()
		SlapUI = nil
	end
	if animationTrack then
		animationTrack:Stop()
		animationTrack = nil  -- 释放
	end
end)