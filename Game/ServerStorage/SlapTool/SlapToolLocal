-- 更新 UI 显示内容
local function UpdateSlapUI()
	if not SlapUI then return end

	local SlapCount = Tool:FindFirstChild("SlapCount")
	local SlapLevel = Tool:FindFirstChild("SlapLevel")
	if not SlapCount or not SlapLevel then return end

	local LevelLabel = SlapUI.MainFrame.LevelLabel
	local CountLabel = SlapUI.MainFrame.CountLabel

	LevelLabel.Text = "Lv." .. SlapLevel.Value
	CountLabel.Text = "x" .. SlapCount.Value

	if SlapCount.Value <= 0 then
		CountLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
	else
		CountLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
	end
end

-- 优化后的播放反馈
local function PlayFeedback()
	-- 音效
	local Sound = Instance.new("Sound")
	Sound.SoundId = "rbxassetid://1835341225"  -- 巴掌音效
	Sound.Volume = 0.8
	Sound.Parent = Tool
	Sound:Play()
	game.Debris:AddItem(Sound, 3)

	-- 动画：只播放一次（缓存Track + Stop再Play）
	if Player.Character and Player.Character:FindFirstChild("Humanoid") and animationTrack then
		animationTrack:Stop()  -- 先停止，确保不叠加
		animationTrack:Play()  -- 从头播放一次
	end
end

-- 点击松开后触发
local canSlap = true  -- 新增冷却变量

Tool.Deactivated:Connect(function()
	if not canSlap then return end
	if Tool.Parent ~= Player.Character then return end   -- 必须装备状态

	local SlapCount = Tool:FindFirstChild("SlapCount")
	if SlapCount and SlapCount.Value > 0 then
		canSlap = false
		SlapEvent:FireServer()
		PlayFeedback()
		task.wait(2)  -- 冷却时间
		canSlap = true
	end
end)

-- 清理函数
local function CleanupTool()
	if SlapUI then
		SlapUI:Destroy()
		SlapUI = nil
	end
	if animationTrack then
		animationTrack:Stop() 
		animationTrack = nil
	end

	-- 如果有 RemoveToolEvent，通知服务器移除道具（可选，防止残留）
	local RemoveToolEvent = ReplicatedStorage:FindFirstChild("RemoveToolEvent")
	if RemoveToolEvent then
		RemoveToolEvent:FireServer("SlapTool")
	end
end

-- 装备时：创建UI + 加载动画Track（只一次） + 绑定 Died
Tool.Equipped:Connect(function()
	CreateSlapUI()
	UpdateSlapUI()

	if Player.Character and Player.Character:FindFirstChild("Humanoid") then
		local Animation = Instance.new("Animation")
		Animation.AnimationId = "rbxassetid://507770239"
		animationTrack = Player.Character.Humanoid:LoadAnimation(Animation)
		animationTrack.Looped = false
	end

	Tool.SlapCount.Changed:Connect(UpdateSlapUI)
	Tool.SlapLevel.Changed:Connect(UpdateSlapUI)

	-- 绑定当前 Humanoid 的 Died 事件（死亡时清理）
	--local humanoid = Player.Character:FindFirstChild("Humanoid")
	--if humanoid then
	--	humanoid.Died:Connect(CleanupTool)
	--end
end)

-- 数量 <=0 时自动清理
Tool.SlapCount.Changed:Connect(function(newCount)
	UpdateSlapUI()
	if newCount <= 0 then
		CleanupTool()
	end
end)

-- 卸下时隐藏 UI
Tool.Unequipped:Connect(function()
	if SlapUI then
		SlapUI:Destroy()
		SlapUI = nil
	end
	if animationTrack then
		animationTrack:Stop()
		animationTrack = nil
	end
end)

-- **全局绑定 Died + 复活重建**
Player.CharacterAdded:Connect(function(character)
	task.wait(0.5)  -- 等待加载
	--local humanoid = character:WaitForChild("Humanoid")
	--humanoid.Died:Connect(CleanupTool)

	-- 复活后如果已装备道具，重建 UI
	if character:FindFirstChild(Tool.Name) then
		CreateSlapUI()
		UpdateSlapUI()
	end
end)

-- 初始检查
task.spawn(function()
	task.wait(2)
	if Tool.Parent == Player.Character then
		CreateSlapUI()
		UpdateSlapUI()
	end
end)