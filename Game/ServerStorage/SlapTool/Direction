local tool = script.Parent

-- 还原工具位置
local originalGrip = tool.Grip

tool.Equipped:Connect(function()
	tool.Grip = originalGrip
		* CFrame.Angles(math.rad(20), math.rad(240), math.rad(10))  -- 翻转
		* CFrame.new(0, -1, 0)                     -- 移动
end)

-- 放下工具时恢复默认
tool.Unequipped:Connect(function()
	tool.Grip = originalGrip
end)