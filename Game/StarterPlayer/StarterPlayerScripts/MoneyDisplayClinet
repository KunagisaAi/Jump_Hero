local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")

local REMOTE_EVENT = ReplicatedStorage:WaitForChild("AwardMoney")
local player = Players.LocalPlayer

-- 创建左上角UI
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "MoneyDisplay"
screenGui.ResetOnSpawn = false

-- 创建一个容器Frame来更好地管理布局
local container = Instance.new("Frame")
container.Name = "Container"
container.Size = UDim2.new(1, 0, 1, 0) -- 增加宽度以容纳更多数字
container.Position = UDim2.new(0, 0, 0, 0)
container.BackgroundTransparency = 1
container.Parent = screenGui

-- 金币UI部分
local goldContainer = Instance.new("Frame")
goldContainer.Name = "GoldContainer"
goldContainer.Size = UDim2.new(1, 0, 1, 0)
goldContainer.Position = UDim2.new(0, 0, 0, 0)
goldContainer.BackgroundTransparency = 1
goldContainer.Parent = container

-- 金币图标
local goldIcon = Instance.new("ImageLabel")
goldIcon.Name = "GoldIcon"
goldIcon.Size = UDim2.new(0.1, 0, 0.1, 0)
goldIcon.Position = UDim2.new(0, 0, 0.01, 0) -- 调整位置使其居中
goldIcon.AnchorPoint = Vector2.new(0, 0) -- 固定在左侧
goldIcon.BackgroundTransparency = 1
goldIcon.Image = "rbxassetid://93706756797285"
goldIcon.ScaleType = Enum.ScaleType.Fit
goldIcon.Parent = goldContainer

-- 金币显示文本
local moneyLabel = Instance.new("TextLabel")
moneyLabel.Name = "MoneyLabel"
moneyLabel.Size = UDim2.new(0.15, 0, 0.15, 0) -- 从图标右侧开始，留出70像素空间
moneyLabel.Position = UDim2.new(0.1, 0, -0.0175, 0) -- 从图标右侧开始
moneyLabel.AnchorPoint = Vector2.new(0, 0) -- 固定在图标右侧
moneyLabel.BackgroundTransparency = 1
moneyLabel.TextColor3 = Color3.new(1, 0.666667, 0)
moneyLabel.Font = Enum.Font.SourceSansBold
moneyLabel.TextScaled = true
moneyLabel.TextWrapped = false
moneyLabel.TextSize = 32
moneyLabel.TextXAlignment = Enum.TextXAlignment.Left -- 文本左对齐，向右扩展
moneyLabel.TextStrokeColor3 = Color3.new(0, 0, 0) -- 黑色描边
moneyLabel.TextStrokeTransparency = 0.5 -- 描边透明度，实现1-2像素的效果
moneyLabel.Text = "Money: 0"
moneyLabel.Parent = goldContainer

screenGui.Parent = player:WaitForChild("PlayerGui")

-- 新内容
local leaderstats = player:WaitForChild("leaderstats")
local moneyValue = leaderstats:WaitForChild("Money")

moneyLabel.Text = "Money: " .. moneyValue.Value

moneyValue.Changed:Connect(function(newValue)
	moneyLabel.Text = "Money: " .. newValue
end)

-- REMOTE_EVENT.OnClientEvent 保留（兼容旧加钱）
REMOTE_EVENT.OnClientEvent:Connect(function(amount)
	-- 无需本地加，leaderstats 已同步
end)