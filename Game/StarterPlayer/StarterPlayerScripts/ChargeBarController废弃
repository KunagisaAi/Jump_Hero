local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer

-- 获取 JumpUI 和 ChargeBar
local function getChargeBar()
	local playerGui = localPlayer:WaitForChild("PlayerGui")
	local jumpUI = playerGui:WaitForChild("JumpUI")
	local chargeBar = jumpUI:WaitForChild("ChargeBar")
	return chargeBar
end

-- ChargeBarController 加这部分（自动居中）
local playerGui = localPlayer:WaitForChild("PlayerGui")
local JumpUI = playerGui:WaitForChild("JumpUI")
local ChargeBackGround = JumpUI:WaitForChild("ChargeBackGround")

ChargeBackGround.AnchorPoint = Vector2.new(0.5, 1)
ChargeBackGround.Position = UDim2.new(0.5, 0, 1, -50)  -- 底部中心，向上50像素

local ChargeBarFrame = JumpUI:WaitForChild("ChargeBarFrame")
ChargeBarFrame.AnchorPoint = Vector2.new(0.5, 0.5)
ChargeBarFrame.Position = UDim2.new(0.5, 0, 0.877, 0)

local ChargeBar = ChargeBarFrame:WaitForChild("ChargeBar")
ChargeBar.AnchorPoint = Vector2.new(0, 0.5)
ChargeBar.Position = UDim2.new(0, 0, 0.5, 0)

-- 更新蓄力条显示（percent: 0~1）
local function updateChargeBar(percent)
	local chargeBar = getChargeBar()
	percent = math.clamp(percent, 0, 1)

	local fullWidth = chargeBar.Size.X.Offset
	local newWidth = math.floor(fullWidth * percent)
	chargeBar.Size = UDim2.new(0, newWidth, chargeBar.Size.Y.Scale, chargeBar.Size.Y.Offset)
end

-- 重置蓄力条
local function resetChargeBar()
	updateChargeBar(0)
end

-- 示例：监听蓄力值变化（需根据实际蓄力逻辑调用 updateChargeBar）
-- 这里假设 chargeValue/maxCharge 得到百分比
-- 可在你的蓄力逻辑中调用 updateChargeBar(percent)

-- 初始化
resetChargeBar()
