	["SlapTool"]   = "rbxassetid://94497172509286",
	["ShieldTool"] = "rbxassetid://105403420633099",
}

local ShopUI = nil

-- ==================== 增强版屏幕适配函数（手机字体自动更小） ====================
local function getScreenSize()
	return workspace.CurrentCamera.ViewportSize
end

local function getScaledTextSize(baseSize)
	local minSide = math.min(getScreenSize().X, getScreenSize().Y)
	local scale = minSide / 1080

	-- 手机额外缩小（底框改成全屏后最关键的修复）
	local isMobile = minSide < 700
	local mobileExtraScale = isMobile and 0.82 or 1.0   -- 手机再缩小18%

	return math.max(12, math.floor(baseSize * scale * mobileExtraScale))
end

-- ==================== 创建按钮（圆角 + 点击动画） ====================
local function createButton(text, color, parent, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 1, 0)
	btn.BackgroundColor3 = color
	btn.Text = text
	btn.TextColor3 = Color3.new(1,1,1)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = getScaledTextSize(17)
	btn.AutoButtonColor = false
	btn.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = btn

	local scale = Instance.new("UIScale")
	scale.Parent = btn

	local tweenInfo = TweenInfo.new(0.1, Enum.EasingStyle.Quad)
	btn.MouseButton1Down:Connect(function() TweenService:Create(scale, tweenInfo, {Scale = 0.93}):Play() end)
	btn.MouseButton1Up:Connect(function() 
		TweenService:Create(scale, tweenInfo, {Scale = 1}):Play()
		if callback then callback() end
	end)
	btn.MouseLeave:Connect(function() TweenService:Create(scale, tweenInfo, {Scale = 1}):Play() end)
	return btn
end

local function CreateShopUI()
	if ShopUI then ShopUI:Destroy() end
	ShopUI = Instance.new("ScreenGui")
	ShopUI.ResetOnSpawn = false
	ShopUI.Parent = PlayerGui

	-- 底框（你改的1,1,1,1 完全保留）
	local MainFrame = Instance.new("ImageLabel")
	MainFrame.Size = UDim2.new(1.2, 0, 1.2, 0)
	MainFrame.Position = UDim2.new(0.5, 0, 0.45, 0)
	MainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	MainFrame.BackgroundTransparency = 1
	MainFrame.Image = BACKGROUND_ID
	MainFrame.ScaleType = Enum.ScaleType.Fit
	MainFrame.Parent = ShopUI

	Instance.new("UIAspectRatioConstraint", MainFrame).AspectRatio = 1.65

	-- 关闭按钮
	local CloseButton = Instance.new("ImageButton")
	CloseButton.Size = UDim2.new(0.055, 0, 0.085, 0)
	CloseButton.Position = UDim2.new(0.78, 0, 0.13, 0)
	CloseButton.BackgroundTransparency = 1
	CloseButton.Image = CLOSE_NORMAL_ID
	CloseButton.HoverImage = CLOSE_HOVER_ID
	CloseButton.Parent = MainFrame
	CloseButton.MouseButton1Click:Connect(function() ShopUI:Destroy() end)

	-- 商品滚动区
	local Content = Instance.new("Frame")
	Content.Size = UDim2.new(0.85, 0, 0.68, 0)
	Content.Position = UDim2.new(0.5, 0, 0.22, 0)
	Content.AnchorPoint = Vector2.new(0.5, 0)
	Content.BackgroundTransparency = 1
	Content.Parent = MainFrame

	local Scrolling = Instance.new("ScrollingFrame")
	Scrolling.Size = UDim2.new(1, 0, 1, 0)
	Scrolling.BackgroundTransparency = 1
	Scrolling.ScrollBarThickness = 8
	Scrolling.AutomaticCanvasSize = Enum.AutomaticSize.Y
	Scrolling.Parent = Content

	local ListLayout = Instance.new("UIListLayout")
	ListLayout.Padding = UDim.new(0.022, 0)
	ListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	ListLayout.Parent = Scrolling

	-- ==================== 生成商品 ====================
	for toolType, config in pairs(ShopConfig) do
		local itemFrame = Instance.new("ImageLabel")
		itemFrame.Size = UDim2.new(0.7, 0, 0.3, 0)
		itemFrame.BackgroundTransparency = 1
		itemFrame.Image = ITEM_BG_ID
		itemFrame.ScaleType = Enum.ScaleType.Stretch
		itemFrame.Parent = Scrolling

		local tool = player.Backpack:FindFirstChild(toolType) or (player.Character and player.Character:FindFirstChild(toolType))
		local currentCount = config.BaseCount
		local currentLevel = 1
		if tool then
			local baseName = string.gsub(toolType, "Tool$", "")
			local c = tool:FindFirstChild(baseName .. "Count") or tool:FindFirstChild("Count")
			local l = tool:FindFirstChild(baseName .. "Level") or tool:FindFirstChild("Level")
			if c then currentCount = c.Value end
			if l then currentLevel = l.Value end
		end

		local mainContainer = Instance.new("Frame")
		mainContainer.Size = UDim2.new(0.8, 0, 0.7, 0)
		mainContainer.Position = UDim2.new(0.5, 0, 0.5, 0)
		mainContainer.AnchorPoint = Vector2.new(0.5, 0.5)
		mainContainer.BackgroundTransparency = 1
		mainContainer.Parent = itemFrame

		local split = Instance.new("UIListLayout")
		split.FillDirection = Enum.FillDirection.Horizontal
		split.Padding = UDim.new(0.025, 0)
		split.VerticalAlignment = Enum.VerticalAlignment.Center
		split.Parent = mainContainer

		-- 左侧图标区
		local leftFrame = Instance.new("Frame")
		leftFrame.Size = UDim2.new(0.38, 0, 1, 0)
		leftFrame.BackgroundTransparency = 1
		leftFrame.Parent = mainContainer

		local iconId = ToolIcons[toolType]
		if iconId then
			local icon = Instance.new("ImageLabel")
			icon.Size = UDim2.new(0.85, 0, 0.65, 0)
			icon.Position = UDim2.new(0.5, 0, 0.38, 0)
			icon.AnchorPoint = Vector2.new(0.5, 0.5)
			icon.BackgroundTransparency = 1
			icon.Image = iconId
			icon.ScaleType = Enum.ScaleType.Fit
			icon.Parent = leftFrame
		end

		local nameLabel = Instance.new("TextLabel")
		nameLabel.Size = UDim2.new(1, 0, 0.2, 0)
		nameLabel.Position = UDim2.new(0, 0, 0.72, 0)
		nameLabel.BackgroundTransparency = 1
		nameLabel.Text = toolType .. "  Lv." .. currentLevel
		nameLabel.TextColor3 = Color3.new(1,1,1)
		nameLabel.Font = Enum.Font.GothamBold
		nameLabel.TextSize = getScaledTextSize(25)
		nameLabel.Parent = leftFrame

		local countLabel = Instance.new("TextLabel")
		countLabel.Size = UDim2.new(1, 0, 0.15, 0)
		countLabel.Position = UDim2.new(0, 0, 0.88, 0)
		countLabel.BackgroundTransparency = 1
		countLabel.Text = "次数: " .. currentCount
		countLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
		countLabel.Font = Enum.Font.Gotham
		countLabel.TextSize = getScaledTextSize(20)
		countLabel.Parent = leftFrame

		-- 右侧按钮区（两行两列）
		local rightFrame = Instance.new("Frame")
		rightFrame.Size = UDim2.new(0.58, 0, 1, 0)
		rightFrame.BackgroundTransparency = 1
		rightFrame.Parent = mainContainer

		local grid = Instance.new("UIGridLayout")
		grid.CellPadding = UDim2.new(0.018, 0, 0.05, 0)
		grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
		grid.VerticalAlignment = Enum.VerticalAlignment.Center

		local screenWidth = getScreenSize().X
		local buttonScale = math.clamp(screenWidth / 700, 0.68, 1)
		grid.CellSize = UDim2.new(0.48, 0, 0.46 * buttonScale, 0)
		grid.Parent = rightFrame

		-- 四个按钮
		createButton("金币 +1次数\n" .. config.BuyCountPrice .. " 金币", Color3.fromRGB(0, 170, 80), rightFrame, function()
			BuyItemEvent:FireServer(toolType, "buyCount")
		end)

		if currentLevel < config.MaxLevel then
			local nextPrice = config.Levels[currentLevel + 1].UpgradePrice
			createButton("金币升级 Lv." .. (currentLevel+1) .. "\n" .. nextPrice .. " 金币", Color3.fromRGB(255, 140, 0), rightFrame, function()
				BuyItemEvent:FireServer(toolType, "upgrade")
			end)
		else
			createButton("已满级", Color3.fromRGB(80,80,80), rightFrame, nil)
		end

		local robuxCountPrice = config.RobuxBuyCountPrice or 20
		createButton("Robux +1次数\n" .. robuxCountPrice .. " Robux", Color3.fromRGB(0, 120, 215), rightFrame, function()
			BuyItemEvent:FireServer(toolType, "buyCountRobux")
		end)

		if currentLevel < config.MaxLevel then
			local nextRPrice = config.Levels[currentLevel + 1].RobuxUpgradePrice or 50
			createButton("Robux升级 Lv." .. (currentLevel+1) .. "\n" .. nextRPrice .. " Robux", Color3.fromRGB(0, 162, 255), rightFrame, function()
				BuyItemEvent:FireServer(toolType, "upgradeRobux")
			end)
		else
			createButton("已满级", Color3.fromRGB(80,80,80), rightFrame, nil)
		end
	end
end

