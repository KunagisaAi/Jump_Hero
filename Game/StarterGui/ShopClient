-- StarterPlayerScripts/ShopClient（UI动态显示 + 按钮文本更新 + 关闭按钮）
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ShopConfig = require(ReplicatedStorage:WaitForChild("ShopConfig"))

local player = Players.LocalPlayer
local PlayerGui = player:WaitForChild("PlayerGui")

-- 获取屏幕尺寸，用于适配不同设备
local function getScreenSize()
	return workspace.CurrentCamera.ViewportSize
end

-- 根据屏幕尺寸计算适合的文本大小
local function getTextSize(baseSize)
	local screenSize = getScreenSize()
	-- 以屏幕较短边为基准计算文本大小
	local minSize = math.min(screenSize.X, screenSize.Y)
	-- 调整文本大小，确保在小屏幕上也能正常显示
	local scaleFactor = minSize / 1080 -- 以1080p为基准
	return math.max(12, math.floor(baseSize * scaleFactor))
end

local OpenShopEvent = ReplicatedStorage:WaitForChild("OpenShopEvent")
local BuyItemEvent = ReplicatedStorage:WaitForChild("BuyItemEvent")
local RefreshShopEvent = ReplicatedStorage:WaitForChild("RefreshShopEvent")

local ShopUI = nil

local function CreateShopUI()
	if ShopUI then ShopUI:Destroy() end

	ShopUI = Instance.new("ScreenGui")
	ShopUI.Name = "ShopUI"
	ShopUI.Parent = PlayerGui

	local Frame = Instance.new("Frame")
	Frame.Size = UDim2.new(0.4, 0, 0.7, 0)
	Frame.Position = UDim2.new(0.3, 0, 0.15, 0)
	Frame.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	Frame.Parent = ShopUI

	-- 获取适合的文本大小
	local titleTextSize = getTextSize(30)
	local buttonTextSize = getTextSize(20)

	-- 标题
	local Title = Instance.new("TextLabel")
	Title.Text = "Tool Shop"
	Title.Size = UDim2.new(1, 0, 0.1, 0)
	Title.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	Title.TextColor3 = Color3.new(1,1,1)
	Title.Font = Enum.Font.GothamBold
	Title.TextSize = titleTextSize
	Title.Parent = Frame

	-- 关闭按钮
	local CloseButton = Instance.new("TextButton")
	CloseButton.Text = "X"
	CloseButton.Size = UDim2.new(0.1, 0, 0.1, 0)
	CloseButton.Position = UDim2.new(1, 0, 0, 0)
	CloseButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
	CloseButton.TextColor3 = Color3.new(1,1,1)
	CloseButton.Font = Enum.Font.GothamBold
	CloseButton.TextSize = titleTextSize
	CloseButton.Parent = Frame
	CloseButton.MouseButton1Click:Connect(function()
		ShopUI:Destroy()
	end)

	local yPos = 0.1
	for toolType, config in pairs(ShopConfig) do
		local tool = player.Backpack:FindFirstChild(toolType) or (player.Character and player.Character:FindFirstChild(toolType))

		-- 智能 baseName
		local baseName = string.gsub(toolType, "Tool$", "")

		local currentCount = config.BaseCount
		local currentLevel = 1
		if tool then
			local countValue = tool:FindFirstChild(baseName .. "Count")
			if countValue then currentCount = countValue.Value end

			local levelValue = tool:FindFirstChild(baseName .. "Level")
			if levelValue then currentLevel = levelValue.Value end
		end

		local toolFrame = Instance.new("Frame")
		toolFrame.Size = UDim2.new(0.95, 0, 0.45, 0)
		toolFrame.Position = UDim2.new(0.025, 0, yPos, 0)
		toolFrame.BackgroundTransparency = 0.5
		toolFrame.Parent = Frame

		local nameLabel = Instance.new("TextLabel")
		nameLabel.Text = toolType .. " Lv." .. currentLevel .. " x" .. currentCount
		nameLabel.Size = UDim2.new(1, 0, 0.2, 0)
		nameLabel.TextSize = buttonTextSize
		nameLabel.Parent = toolFrame

		if not tool then
			local countPrice = config.BuyCountPrice
			local buyBtn = Instance.new("TextButton")
			buyBtn.Text = "Purchase Tool (" .. countPrice .. " Money)"
			buyBtn.Size = UDim2.new(0.85, 0, 0.2, 0)
			buyBtn.Position = UDim2.new(0.08, 0, 0.3, 0)
			buyBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
			buyBtn.TextSize = buttonTextSize
			buyBtn.Parent = toolFrame
			buyBtn.MouseButton1Click:Connect(function()
				BuyItemEvent:FireServer(toolType, "buyTool")
			end)
		else
			local countPrice = config.BuyCountPrice
			local countBtn = Instance.new("TextButton")
			countBtn.Text = "Purchase Count (" .. countPrice .. " Money)"
			countBtn.Size = UDim2.new(0.85, 0, 0.2, 0)
			countBtn.Position = UDim2.new(0.08, 0, 0.3, 0)
			countBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 255)
			countBtn.TextSize = buttonTextSize
			countBtn.Parent = toolFrame
			countBtn.MouseButton1Click:Connect(function()
				BuyItemEvent:FireServer(toolType, "buyCount")
			end)

			if currentLevel < config.MaxLevel then
				local nextLevel = currentLevel + 1
				local upgradePrice = config.Levels[nextLevel].UpgradePrice
				local upgradeBtn = Instance.new("TextButton")
				upgradeBtn.Text = "Level Up (" .. upgradePrice .. " Money)"
				upgradeBtn.Size = UDim2.new(0.85, 0, 0.2, 0)
				upgradeBtn.Position = UDim2.new(0.08, 0, 0.6, 0)
				upgradeBtn.BackgroundColor3 = Color3.fromRGB(255, 150, 0)
				upgradeBtn.TextSize = buttonTextSize
				upgradeBtn.Parent = toolFrame
				upgradeBtn.MouseButton1Click:Connect(function()
					BuyItemEvent:FireServer(toolType, "upgrade")
				end)
			else
				local maxLabel = Instance.new("TextLabel")
				maxLabel.Text = "Level Cap！"
				maxLabel.TextColor3 = Color3.new(0,1,0)
				maxLabel.Position = UDim2.new(0.1, 0, 0.6, 0)
				maxLabel.TextSize = buttonTextSize
				maxLabel.Parent = toolFrame
			end
		end
		-- 两个图片栏之间的差距
		yPos = yPos + 0.425
	end
end

OpenShopEvent.OnClientEvent:Connect(CreateShopUI)
RefreshShopEvent.OnClientEvent:Connect(CreateShopUI)  -- 购买/升级后重建UI，文本自动更新下一级