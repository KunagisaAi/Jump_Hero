-- ====================== 图片ID ======================
local BACKGROUND_ID   = "rbxassetid://94888497864695"
local ITEM_BG_ID      = "rbxassetid://127777237746687"
local CLOSE_NORMAL_ID = "rbxassetid://128604353538348"
local CLOSE_HOVER_ID  = "rbxassetid://135507042277073"

