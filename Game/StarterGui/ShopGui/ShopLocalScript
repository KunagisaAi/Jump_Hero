local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local ShopGui = script.Parent  -- ScreenGui

local BuyItemEvent = Instance.new("RemoteEvent")
BuyItemEvent.Name = "BuyItemEvent"
BuyItemEvent.Parent = ReplicatedStorage

local OpenShopEvent = ReplicatedStorage:WaitForChild("OpenShopEvent")
local ShopConfig = require(ReplicatedStorage:WaitForChild("ShopConfig"))

-- 打开商店
OpenShopEvent.OnClientEvent:Connect(function()
	ShopGui.Enabled = true
	-- 更新金币（兼容你的 MoneyDisplayClient）
	local gold = player.leaderstats.Gold.Value
	ShopGui.Frame.GoldLabel.Text = "金币: " .. gold
end)

-- 关闭按钮
ShopGui.Frame.CloseButton.MouseButton1Click:Connect(function()
	ShopGui.Enabled = false
end)

-- 动态生成商品按钮（ScrollingFrame 里）
for _, item in ipairs(ShopConfig) do
	local Button = Instance.new("TextButton")
	Button.Name = "Item" .. item.id
	Button.Size = UDim2.new(0, 200, 0, 50)
	Button.Text = item.name .. " - " .. item.price .. "金\n" .. item.description
	Button.Parent = ShopGui.Frame.ScrollingFrame

	Button.MouseButton1Click:Connect(function()
		BuyItemEvent:FireServer(item.id)  -- 买这个
	end)
end

-- 金币更新监听（兼容你的系统）
player.leaderstats.Gold.Changed:Connect(function(newGold)
	ShopGui.Frame.GoldLabel.Text = "金币: " .. newGold
end)