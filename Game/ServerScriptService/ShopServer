local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local ShopConfig = require(ReplicatedStorage:WaitForChild("ShopConfig"))
local DataManager = game.ServerScriptService:WaitForChild("ToolManager")

local BuyItemEvent = ReplicatedStorage:FindFirstChild("BuyItemEvent") or Instance.new("RemoteEvent")
BuyItemEvent.Name = "BuyItemEvent"
BuyItemEvent.Parent = ReplicatedStorage

local RefreshShopEvent = ReplicatedStorage:FindFirstChild("RefreshShopEvent") or Instance.new("RemoteEvent")
RefreshShopEvent.Name = "RefreshShopEvent"
RefreshShopEvent.Parent = ReplicatedStorage

local function FindPlayerTool(player, toolType)
	local character = player.Character
	local backpack = player.Backpack
	if character then
		local found = character:FindFirstChild(toolType)
		if found then return found end
	end
	return backpack:FindFirstChild(toolType)
end

local function CreatePlayerToolIfNotExist(player, toolType)
	local tool = FindPlayerTool(player, toolType)
	if tool then return tool end

	local template = ServerStorage:FindFirstChild(toolType)
	if not template then 
		warn("ServerStorage缺少道具模板:", toolType)
		return nil 
	end

	tool = template:Clone()
	tool.Parent = player.Backpack

	local baseName = string.gsub(toolType, "Tool$", "")
	local countValue = tool:FindFirstChild(baseName .. "Count") or Instance.new("IntValue")
	countValue.Name = baseName .. "Count"
	countValue.Value = ShopConfig[toolType].BaseCount   -- 首次购买正确为1
	countValue.Parent = tool

	local levelValue = tool:FindFirstChild(baseName .. "Level") or Instance.new("IntValue")
	levelValue.Name = baseName .. "Level"
	levelValue.Value = 1
	levelValue.Parent = tool

	return tool
end

BuyItemEvent.OnServerEvent:Connect(function(player, toolType, action)
	local config = ShopConfig[toolType]
	if not config then return end

	if action == "buyCount" then
		local tool = CreatePlayerToolIfNotExist(player, toolType)
		if not tool then return end

		local moneyValue = player.leaderstats:FindFirstChild("Money")
		if not moneyValue or moneyValue.Value < config.BuyCountPrice then return end

		moneyValue.Value -= config.BuyCountPrice

		local baseName = string.gsub(toolType, "Tool$", "")
		local countValue = tool:FindFirstChild(baseName .. "Count") or tool:FindFirstChild("Count")
		if countValue then countValue.Value += 1 end

		DataManager.SavePlayerTools:Fire(player)
		RefreshShopEvent:FireClient(player)

	elseif action == "upgrade" then
		local tool = FindPlayerTool(player, toolType)
		if not tool then return end
		local baseName = string.gsub(toolType, "Tool$", "")
		local levelValue = tool:FindFirstChild(baseName .. "Level") or tool:FindFirstChild("Level")
		if not levelValue or levelValue.Value >= config.MaxLevel then return end

		local nextLevel = levelValue.Value + 1
		local price = config.Levels[nextLevel].UpgradePrice
		local moneyValue = player.leaderstats:FindFirstChild("Money")
		if not moneyValue or moneyValue.Value < price then return end

		moneyValue.Value -= price
		levelValue.Value = nextLevel

		DataManager.SavePlayerTools:Fire(player)
		RefreshShopEvent:FireClient(player)

	elseif action == "buyCountRobux" then
		local productId = config.RobuxBuyCountProductId
		if productId and productId > 0 then
			MarketplaceService:PromptProductPurchase(player, productId)
		end

	elseif action == "upgradeRobux" then
		local productId = config.RobuxUpgradeProductId
		if productId and productId > 0 then
			MarketplaceService:PromptProductPurchase(player, productId)
		end
	end
end)

MarketplaceService.ProcessReceipt = function(receiptInfo)
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then return Enum.ProductPurchaseDecision.NotProcessedYet end

	local productId = receiptInfo.ProductId
	local DataManager = game.ServerScriptService:WaitForChild("ToolManager")

	for toolType, config in pairs(ShopConfig) do
		local baseName = string.gsub(toolType, "Tool$", "")

		if config.RobuxBuyCountProductId == productId then
			local tool = CreatePlayerToolIfNotExist(player, toolType)
			if tool then
				local countValue = tool:FindFirstChild(baseName .. "Count") or tool:FindFirstChild("Count")
				if countValue then countValue.Value += 1 end
				DataManager.SavePlayerTools:Fire(player)
				RefreshShopEvent:FireClient(player)
			end
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end

		if config.RobuxUpgradeProductId == productId then
			local tool = FindPlayerTool(player, toolType)
			if tool then
				local levelValue = tool:FindFirstChild(baseName .. "Level") or tool:FindFirstChild("Level")
				if levelValue and levelValue.Value < config.MaxLevel then
					levelValue.Value += 1
					DataManager.SavePlayerTools:Fire(player)
					RefreshShopEvent:FireClient(player)
				end
			end
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end

	return Enum.ProductPurchaseDecision.NotProcessedYet
end