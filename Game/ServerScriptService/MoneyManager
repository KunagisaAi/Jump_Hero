local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")

local moneyDataStore = DataStoreService:GetDataStore("PlayerMoney")

-- ==================== 加载（兼容旧数据 + 新表格） ====================
local function loadPlayerMoney(player)
	local userId = tostring(player.UserId)

	local success, playerData = pcall(function()
		return moneyDataStore:GetAsync(userId)
	end)

	if success then
		-- 新格式：表格
		if type(playerData) == "table" and playerData.Money ~= nil then
			return playerData.Money
			-- 旧格式：纯数字（自动兼容）
		elseif type(playerData) == "number" then
			return playerData
		end
	end

	return 100 -- 默认初始金币
end

-- ==================== 保存（始终保存成表格） ====================
local function savePlayerMoney(player)
	local userId = tostring(player.UserId)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then return end

	local moneyValue = leaderstats:FindFirstChild("Money")
	if moneyValue then
		local playerData = {
			Money = moneyValue.Value
		}

		local success, errorMessage = pcall(function()
			moneyDataStore:SetAsync(userId, playerData)
		end)

		if not success then
			warn("保存金币失败:", errorMessage)
		end
	end
end

-- ==================== 玩家加入 ====================
Players.PlayerAdded:Connect(function(player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player

	local money = Instance.new("IntValue")
	money.Name = "Money"
	money.Value = loadPlayerMoney(player)   -- 加载（兼容旧数据）
	money.Parent = leaderstats

	-- 加载完立刻保存一次 → 自动把旧的纯数字迁移成新表格
	savePlayerMoney(player)

	-- 监听变化（推荐加防抖，防止刷钱时疯狂保存）
	local lastSaveTime = 0
	money.Changed:Connect(function()
		if tick() - lastSaveTime < 1 then return end  -- 1秒内只保存一次
		lastSaveTime = tick()
		savePlayerMoney(player)
	end)
end)

-- ==================== 玩家离开 ====================
Players.PlayerRemoving:Connect(function(player)
	savePlayerMoney(player)
end)

-- ==================== 每5分钟全服保存 ====================
task.spawn(function()
	while true do
		task.wait(300)
		for _, player in ipairs(Players:GetPlayers()) do
			savePlayerMoney(player)
		end
	end
end)