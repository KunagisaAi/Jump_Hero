local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")

local moneyDataStore = DataStoreService:GetDataStore("PlayerMoney")

local function savePlayerMoney(player)
	local userId = tostring(player.UserId)
	local moneyValue = player:FindFirstChild("leaderstats"):FindFirstChild("Money")
	if moneyValue then
		local success, errorMessage = pcall(function()
			moneyDataStore:SetAsync(userId, moneyValue.Value)
		end)
		if not success then
			warn("保存金币失败:", errorMessage)
		end
	end
end

local function loadPlayerMoney(player)
	local userId = tostring(player.UserId)
	local success, moneyValue = pcall(function()
		return moneyDataStore:GetAsync(userId)
	end)

	if success and moneyValue then
		return moneyValue
	else
		return 1000 -- 默认初始值
	end
end

Players.PlayerAdded:Connect(function(player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player

	local money = Instance.new("IntValue")
	money.Name = "Money"
	money.Value = loadPlayerMoney(player) -- 加载保存的金币
	money.Parent = leaderstats

	-- 监听金币数值变化，确保ShopServer等修改时能及时保存
	money.Changed:Connect(function()
		savePlayerMoney(player)
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	savePlayerMoney(player)
end)

-- 定期保存，防止意外崩溃导致数据丢失
task.spawn(function()
	while true do
		task.wait(300) -- 每5分钟保存一次
		for _, player in ipairs(Players:GetPlayers()) do
			savePlayerMoney(player)
		end
	end
end)