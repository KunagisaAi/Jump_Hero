local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local ShieldEvent = ReplicatedStorage:FindFirstChild("ShieldEvent") or Instance.new("RemoteEvent")
ShieldEvent.Name = "ShieldEvent"
ShieldEvent.Parent = ReplicatedStorage

local DataManager = game.ServerScriptService:WaitForChild("ToolManager")

local function FindPlayerShieldTool(player)
	local character = player.Character
	local backpack = player.Backpack
	if character then
		for _, tool in ipairs(character:GetChildren()) do
			if tool:IsA("Tool") and tool:FindFirstChild("ShieldCount") then return tool end
		end
	end
	for _, tool in ipairs(backpack:GetChildren()) do
		if tool:IsA("Tool") and tool:FindFirstChild("ShieldCount") then return tool end
	end
	return nil
end

local function OnShield(player)
	local playerTool = FindPlayerShieldTool(player)
	if not playerTool then return end

	local ShieldCount = playerTool:FindFirstChild("ShieldCount")
	local ShieldLevel = playerTool:FindFirstChild("ShieldLevel")
	if not ShieldCount or not ShieldLevel or ShieldCount.Value <= 0 then return end

	ShieldCount.Value = ShieldCount.Value - 1

	DataManager.SavePlayerTools:Fire(player)  -- 使用后立即保存

	local Character = player.Character
	if not Character then return end
	local Humanoid = Character:FindFirstChild("Humanoid")
	if not Humanoid then return end

	local originalHealth = Humanoid.Health
	local healthConnection = Humanoid.HealthChanged:Connect(function(newHealth)
		if newHealth < originalHealth then
			Humanoid.Health = originalHealth
		end
	end)

	local ForceField = Instance.new("ForceField")
	ForceField.Parent = Character

	local ShieldActive = Instance.new("BoolValue")
	ShieldActive.Name = "ShieldActive"
	ShieldActive.Value = true
	ShieldActive.Parent = Character

	local Duration = 3 + 0.5 * (ShieldLevel.Value - 1)

	task.delay(Duration, function()
		if ForceField and ForceField.Parent then ForceField:Destroy() end
		if ShieldActive and ShieldActive.Parent then ShieldActive:Destroy() end
		if healthConnection then healthConnection:Disconnect() end
	end)
end

ShieldEvent.OnServerEvent:Connect(OnShield)