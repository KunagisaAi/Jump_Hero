-- ==================== 玩家加入/离开 ====================
Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function()
		task.wait(0.5)
		loadPlayerTools(player)
	end)
	loadPlayerTools(player)
end)

Players.PlayerRemoving:Connect(function(player)
	savePlayerTools(player)
	playerToolData[player] = nil
end)

-- ==================== 每3分钟全服保存 ====================
task.spawn(function()
	while true do
		task.wait(180)
		for _, p in ipairs(Players:GetPlayers()) do
			savePlayerTools(p)
		end
	end
end)

-- ==================== RemoveToolEvent ====================
local RemoveToolEvent = ReplicatedStorage:FindFirstChild("RemoveToolEvent") or Instance.new("RemoteEvent")
RemoveToolEvent.Name = "RemoveToolEvent"
RemoveToolEvent.Parent = ReplicatedStorage

local function RemovePlayerTool(player, toolName)
	if player.Character then
		local equipped = player.Character:FindFirstChild(toolName)
		if equipped then equipped:Destroy() end
	end
	local backpackTool = player.Backpack:FindFirstChild(toolName)
	if backpackTool then backpackTool:Destroy() end
end

-- ==================== 新增：公开读取历史等级 ====================
local function GetSavedToolInfo(player, toolName)
	if playerToolData[player] and playerToolData[player][toolName] then
		return playerToolData[player][toolName]
	end
	return nil
end

local GetToolInfoEvent = Instance.new("BindableFunction")
GetToolInfoEvent.Name = "GetSavedToolInfo"
GetToolInfoEvent.Parent = script
GetToolInfoEvent.OnInvoke = GetSavedToolInfo

RemoveToolEvent.OnServerEvent:Connect(RemovePlayerTool)