-- ServerScriptService/ToolManager（合并版）
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local playerToolsDataStore = DataStoreService:GetDataStore("PlayerTools")

local TOOLS_TO_SAVE = {"SlapTool", "ShieldTool"}  -- 以后加新道具只需在这里加名字

local playerToolData = {}

-- ==================== 加载道具 ====================
local function loadPlayerTools(player)
	local userId = tostring(player.UserId)
	local success, savedData = pcall(function()
		return playerToolsDataStore:GetAsync(userId)
	end)

	local data = (success and savedData) or {}
	playerToolData[player] = data

	for _, toolName in ipairs(TOOLS_TO_SAVE) do
		local info = data[toolName]
		if info and info.Count and info.Count > 0 then
			local template = ServerStorage:FindFirstChild(toolName)
			if template then
				local tool = template:Clone()

				local baseName = string.gsub(toolName, "Tool$", "")
				local countVal = tool:FindFirstChild(baseName.."Count") or Instance.new("IntValue")
				countVal.Name = baseName.."Count"
				countVal.Value = info.Count
				countVal.Parent = tool

				local levelVal = tool:FindFirstChild(baseName.."Level") or Instance.new("IntValue")
				levelVal.Name = baseName.."Level"
				levelVal.Value = info.Level or 1
				levelVal.Parent = tool

				tool.Parent = player.Backpack
			end
		end
	end
end

-- ==================== 保存道具（已修复最高等级永久记录） ====================
local function savePlayerTools(player)
	local userId = tostring(player.UserId)

	-- === 关键修复：先复制内存里的旧数据（保留最高等级）===
	local data = {}
	if playerToolData[player] then
		for k, v in pairs(playerToolData[player]) do
			data[k] = { Count = v.Count, Level = v.Level }
		end
	end

	-- === 更新当前背包/角色里的道具数据（数量或等级改变时）===
	for _, toolName in ipairs(TOOLS_TO_SAVE) do
		local tool = player.Backpack:FindFirstChild(toolName) or (player.Character and player.Character:FindFirstChild(toolName))
		if tool then
			local baseName = string.gsub(toolName, "Tool$", "")
			local countVal = tool:FindFirstChild(baseName.."Count") or tool:FindFirstChild("Count")
			local levelVal = tool:FindFirstChild(baseName.."Level") or tool:FindFirstChild("Level")

			local count = countVal and countVal.Value or 0
			local level = levelVal and levelVal.Value or 1

			data[toolName] = {
				Count = count,
				Level = level
			}
		end
		-- 注意：如果当前没有道具，就保留上次的记录（最高等级不会丢失！）
	end

	-- 更新内存 + 保存到DataStore
	playerToolData[player] = data
	pcall(function()
		playerToolsDataStore:SetAsync(userId, data)
	end)
end

-- ==================== 公开保存接口 ====================
local SaveEvent = Instance.new("BindableEvent")
SaveEvent.Name = "SavePlayerTools"
SaveEvent.Parent = script

SaveEvent.Event:Connect(function(player)
	if player then savePlayerTools(player) end
end)

