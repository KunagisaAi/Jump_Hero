local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")

local savePointDataStore = DataStoreService:GetDataStore("PlayerSavePoints")

-- 每个玩家的最后存档点位置（Vector3）
local playerLastSavePosition = {}

-- 新增：记录玩家当前绑定的存档点 Part（防止同一平台重复保存）
local playerCurrentSavePart = {}

-- 默认出生点
local defaultSpawnPosition = Workspace:FindFirstChild("SpawnLocation") 
	and Workspace.SpawnLocation.Position 
	or Vector3.new(0, 5, 0)

-- 无敌冷却表
local invinciblePlayers = {}

-- ==================== 数据加载/保存 ====================
local function loadPlayerSavePoint(player)
	local userId = tostring(player.UserId)
	local success, data = pcall(function()
		return savePointDataStore:GetAsync(userId)
	end)

	if success and data and data.LastSavePointPosition then
		local p = data.LastSavePointPosition
		return Vector3.new(p.X, p.Y, p.Z)
	end
	return nil
end

local function savePlayerSavePoint(player)
	local userId = tostring(player.UserId)
	local pos = playerLastSavePosition[player]
	if not pos then return end

	local data = {
		LastSavePointPosition = {X = pos.X, Y = pos.Y, Z = pos.Z}
	}

	local success, err = pcall(function()
		savePointDataStore:SetAsync(userId, data)
	end)

	if not success then
		warn("保存存档点失败:", err)
	end
end

-- ==================== 获取存档点位置 ====================
local function getPlayerSpawnPosition(player)
	return playerLastSavePosition[player] or defaultSpawnPosition
end

-- ==================== 传送函数 ====================
local function teleportToSpawn(player)
	local character = player.Character
	if not character then return end

	local spawnPos = getPlayerSpawnPosition(player)
	local aboveCFrame = CFrame.new(spawnPos + Vector3.new(0, 5, 0))
	character:PivotTo(aboveCFrame)
end

-- ==================== 触碰处理（已优化！） ====================
local function onTouched(player, hit)
	if not hit or not hit:IsA("BasePart") then return end

	local character = player.Character
	if not character then return end

	local humanoid = character:FindFirstChild("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return end

	-- === SavePoint 逻辑（关键优化在这里） ===
	if hit.Name == "SavePoint" then
		-- 只有当存档点 Part 实例不同时才保存（站在同一个平台上不会重复！）
		if playerCurrentSavePart[player] ~= hit then
			playerCurrentSavePart[player] = hit
			playerLastSavePosition[player] = hit.Position
			savePlayerSavePoint(player)   -- 只保存一次

			-- 可选调试（测试完可删掉或注释）
			-- print(player.Name .. " 已更新存档点 → " .. hit:GetFullName())
		end
		return
	end

	-- === Baseplate 掉落伤害（保持不变） ===
	if hit.Name == "Baseplate" then
		if invinciblePlayers[player] then return end
		invinciblePlayers[player] = true

		humanoid.Health = math.max(humanoid.Health - 40, 0)

		if humanoid.Health > 0 then
			teleportToSpawn(player)
		end

		task.delay(1, function()
			invinciblePlayers[player] = nil
		end)
	end
end

-- ==================== 角色设置（保持不变） ====================
local function setupCharacter(player, character)
	local humanoid = character:FindFirstChild("Humanoid")
	if not humanoid then return end

	for _, part in ipairs(character:GetChildren()) do
		if part:IsA("BasePart") then
			part.Touched:Connect(function(hit)
				onTouched(player, hit)
			end)
		end
	end

	humanoid.Died:Connect(function()
		player.CharacterAdded:Wait()
		task.wait(0.1)
		teleportToSpawn(player)
	end)
end

-- ==================== 玩家加入 ====================
Players.PlayerAdded:Connect(function(player)
	-- 加载存档点位置
	playerLastSavePosition[player] = loadPlayerSavePoint(player)
	playerCurrentSavePart[player] = nil   -- 重置当前Part

	player.CharacterAdded:Connect(function(character)
		setupCharacter(player, character)
	end)

	if player.Character then
		setupCharacter(player, player.Character)
	end
end)

-- ==================== 玩家离开 ====================
Players.PlayerRemoving:Connect(function(player)
	savePlayerSavePoint(player)
	playerLastSavePosition[player] = nil
	playerCurrentSavePart[player] = nil
end)

-- ==================== 每5分钟全服保存 ====================
task.spawn(function()
	while true do
		task.wait(300)
		for _, player in ipairs(Players:GetPlayers()) do
			savePlayerSavePoint(player)
		end
	end
end)

-- ==================== RemoteEvent 处理（传送按钮） ====================
local TeleportEvent = ReplicatedStorage:FindFirstChild("TeleportEvent")
if not TeleportEvent then
	TeleportEvent = Instance.new("RemoteEvent")
	TeleportEvent.Name = "TeleportEvent"
	TeleportEvent.Parent = ReplicatedStorage
end

local MAIN_CITY_POS = Vector3.new(-2, 0.5, 116.5)

local function teleportPlayer(player, targetPos)
	local character = player.Character
	if not character then return end
	local aboveCFrame = CFrame.new(targetPos + Vector3.new(0, 5, 0))
	character:PivotTo(aboveCFrame)
end

TeleportEvent.OnServerEvent:Connect(function(player, teleportType)
	if teleportType == "MainCity" then
		teleportPlayer(player, MAIN_CITY_POS)
	elseif teleportType == "SavePoint" then
		teleportPlayer(player, getPlayerSpawnPosition(player))
	end
end)