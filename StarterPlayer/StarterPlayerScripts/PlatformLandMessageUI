local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PlatformLandMessage = ReplicatedStorage:WaitForChild("PlatformLandMessage")
local ContentProvider = game:GetService("ContentProvider")
local TweenService = game:GetService("TweenService") -- 添加TweenService

-- 预加载所有图片
local imageAssets = {
    "rbxassetid://111743689000728",  -- PERFECT
    "rbxassetid://91491256507420",   -- GREAT
    "rbxassetid://71871337320235",   -- GOOD
    "rbxassetid://117163375852005",  -- BAD
}

-- 预加载内容
local startTime = os.clock()
ContentProvider:PreloadAsync(imageAssets, function(assetId, status)
    print("预加载资产:", assetId, "状态:", status)
end)
local deltaTime = os.clock() - startTime
print(("图片预加载完成，耗时 %.2f 秒"):format(deltaTime))

PlatformLandMessage.OnClientEvent:Connect(function(messageType)
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "PlatformLandMessageUI"
    screenGui.ResetOnSpawn = false
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling -- 设置ZIndex行为
    screenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")

    local imageLabel = Instance.new("ImageLabel")
    imageLabel.AnchorPoint = Vector2.new(0.5, 1)
    imageLabel.Position = UDim2.new(0.5, 0, 1, -200)
    imageLabel.Size = UDim2.new(0, 300, 0, 150)
    imageLabel.BackgroundTransparency = 1
    imageLabel.ImageTransparency = 1  -- 初始完全透明
    imageLabel.ScaleType = Enum.ScaleType.Fit
    imageLabel.Parent = screenGui

    -- 根据消息类型设置图片
    local imageMap = {
        PERFECT = "rbxassetid://111743689000728",
        GREAT = "rbxassetid://91491256507420",
        GOOD = "rbxassetid://71871337320235",
        BAD = "rbxassetid://117163375852005"
    }
    
    imageLabel.Image = imageMap[messageType] or ""

    if imageLabel.Image ~= "" then
        -- 使用TweenService实现更平滑的动画（性能更好）
        local fadeInInfo = TweenInfo.new(
            0.5,  -- 持续时间
            Enum.EasingStyle.Quad,  -- 缓动风格
            Enum.EasingDirection.Out  -- 缓动方向
        )
        
        local fadeOutInfo = TweenInfo.new(
            0.5,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.In
        )
        
        -- 淡入
        local fadeIn = TweenService:Create(imageLabel, fadeInInfo, {ImageTransparency = 0})
        fadeIn:Play()
        
        -- 等待显示时间
        task.wait(1.5)  -- 总显示时间
        
        -- 淡出
        local fadeOut = TweenService:Create(imageLabel, fadeOutInfo, {ImageTransparency = 1})
        fadeOut:Play()
        
        -- 等待淡出完成再销毁
        fadeOut.Completed:Wait()
    end
    
    screenGui:Destroy()
end)